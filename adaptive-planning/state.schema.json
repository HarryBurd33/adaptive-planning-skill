{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "week_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "sleep": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            },
            "end": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "timezone",
        "week_start",
        "sleep"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "remaining_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "preferred_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "flexible": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "min_session_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "recurrence": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "frequency": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "minutes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "frequency",
              "count",
              "minutes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "remaining_minutes",
          "deadline",
          "preferred_date",
          "priority",
          "required",
          "flexible",
          "dependencies",
          "min_session_minutes",
          "recurrence"
        ],
        "additionalProperties": false
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "remaining_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "task_id",
          "period_start",
          "period_end",
          "remaining_minutes"
        ],
        "additionalProperties": false
      }
    },
    "fixed_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fixed",
              "protected",
              "transition",
              "meal",
              "break",
              "buffer",
              "unavailable"
            ]
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "title",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "model_week": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "start": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "weekday",
          "start",
          "end",
          "task_id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "dated_plan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "occurrence_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "planned",
                  "completed"
                ]
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "task_id",
              "occurrence_id",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "unscheduled": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "occurrence_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "minutes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task_id",
              "occurrence_id",
              "minutes",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "start",
        "end",
        "blocks",
        "unscheduled"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "occurrence_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "remaining_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "actual_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "task_id",
          "occurrence_id",
          "observed_at",
          "remaining_minutes",
          "actual_minutes",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "observed_at",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "adaptations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reversible": {
            "type": "boolean"
          },
          "reverts": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "observed_at",
          "evidence_ids",
          "before",
          "after",
          "reason",
          "reversible",
          "reverts"
        ],
        "additionalProperties": false
      }
    },
    "applied_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          }
        },
        "required": [
          "id",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "constraints_v2": {
          "type": "object",
          "properties": {
            "availability": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "buffer_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sleep_exceptions": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "updated_at",
    "profile",
    "tasks",
    "occurrences",
    "fixed_events",
    "model_week",
    "dated_plan",
    "progress",
    "feedback",
    "adaptations",
    "applied_updates",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adaptive-planning/state.schema.json",
  "title": "Adaptive planning state v1/v2"
}
